# Copy to .env (git-ignored) and fill in. Every value here is a default or a placeholder; real env vars win.

# --- FalkorDB -------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Only if your FalkorDB has ACL auth enabled (e.g. FalkorDB Cloud):
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# TLS (FalkorDB Cloud and most hosted Redis need it):
# FALKORDB_SSL=true
# Or everything in one URL (overrides the fields above): rediss:// for TLS, redis:// without.
# FALKORDB_URL=rediss://<user>:<password>@<host>:<port>

# Tenant used when none is given (each tenant is its own graph: tenant_<name>).
DEFAULT_TENANT=acme

# --- Planner / LLM ----------------------------------------------------------
# mock       deterministic rule-based planner, no key needed (the default; what `make demo` uses)
# gemini     Google Gemini via its OpenAI-compatible API   (default model gemini-2.5-flash)
# openai     OpenAI                                        (default model gpt-4.1-mini)
# groq       Groq                                          (default model llama-3.3-70b-versatile)
# openrouter OpenRouter                                    (default model google/gemini-2.5-flash)
# ollama     local Ollama at http://localhost:11434/v1, no key (default model qwen2.5:7b)
# anthropic  Anthropic Messages API                        (default model claude-sonnet-5-5)
# Any other OpenAI-compatible endpoint: LLM_PROVIDER=openai plus LLM_BASE_URL and LLM_MODEL.
# With no key the app silently uses the mock planner. If a real model errors, times out (15 s) or picks an
# invalid/repeated step, that one decision falls back to the mock planner and the trace says "LLM fallback: ...".
LLM_PROVIDER=mock
# Override the preset's default model.
LLM_MODEL=
# Override the preset's base URL (OpenAI-compatible providers only).
LLM_BASE_URL=
# API key for the selected provider. If empty, the vendor's usual variable is used instead:
# OPENAI_API_KEY, GEMINI_API_KEY or GOOGLE_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, ANTHROPIC_API_KEY.
LLM_API_KEY=
# Most tokens (input + output) one incident run may spend on the model. Past the cap the deterministic planner
# finishes the run and the trace says so. A full run on Claude is ~60-90k tokens.
LLM_RUN_TOKEN_CAP=300000

# --- HTTP API and MCP over HTTP ----------------------------------------------
# Requests whose Host header is not localhost, 127.0.0.1, [::1], testserver, app or 0.0.0.0 are refused (blocks DNS
# rebinding against a localhost demo). Add the names you deploy under, comma-separated (*.example.com works for the
# API); * accepts any Host.
ALLOWED_HOSTS=
# POST requests whose Origin header names another site are refused with 403 (CSRF from a page you happen to visit).
# Requests without Origin (curl, scripts) and the bundled UI are unaffected. Behind a reverse proxy, pass the original
# Host header through (nginx: proxy_set_header Host $host).
# Optional bearer token for headless/API deployments: when set, every /api/* route except /api/health needs
# "Authorization: Bearer <token>". The bundled web UI does not send it, so leave this empty for the UI demo.
API_TOKEN=
# The token the MCP endpoint of a deployment requires (`make serve`, the Dockerfile serve /mcp only with one; the
# standalone `make mcp-http` stays open without it). Falls back to API_TOKEN. The Claude Code plugin sends it as
# ONCALL_BRAIN_TOKEN. Set this one, not API_TOKEN, when the same deployment should also serve the web UI.
MCP_TOKEN=
# Most tenant graphs a reset may create (each new tenant seeds ~5 MB); existing tenants can always be reset.
MAX_TENANTS=20

# --- Abuse limits for a public URL (docs/ARCHITECTURE.md 2.5) ----------------------------------------------------
# Each is off at 0 (the default). Throttles are per client address in fixed windows, counted in FalkorDB, so the app
# and a standalone MCP process share them and a restart keeps them. Over a limit the API answers 429 with Retry-After
# and MCP a tool error with the same words.
# Public preset: set all of these on any public URL with a real model behind it (render.yaml does):
#   RATE_LIMIT_PER_MIN=120  WRITES_PER_MIN=20  RUNS_PER_HOUR=12  MAX_CONCURRENT_RUNS=2  LLM_DAILY_TOKEN_CAP=2000000
#   LLM_HOURLY_TOKEN_CAP=500000  LOCK_WAIT_SECONDS=5  MAX_TENANTS=5  MAX_BODY_BYTES=65536
#   and FORWARDED_ALLOW_IPS for your proxy (below)
# Requests to /api/* and /mcp per client per minute. /api/health, /health, the UI and static files never count.
RATE_LIMIT_PER_MIN=0
# Non-GET /api/* requests and MCP write tools per client per minute (the alert webhook and Ask count: Ask records the
# question in the asker's session).
WRITES_PER_MIN=0
# Agent runs (respond, respond/stream, the webhook with ?respond=true, respond_to_alert over MCP) and tenant resets
# per client per hour; ?compare=memory (act 2 in the UI) is two runs. One run on Claude takes 60-150 s and ~60-100k
# tokens. The three acts once are 4 runs (5 with a reset), so 12 lets one visitor replay the story twice an hour.
RUNS_PER_HOUR=0
# Agent runs in progress at once in one app process; one more is refused with 429, not queued.
MAX_CONCURRENT_RUNS=0
# LLM tokens per UTC day across every process on this FalkorDB (2,000,000 is roughly 20-30 runs on Claude). Past it
# the rules planner decides every step until 00:00 UTC and the trace says so; /api/health shows the day's spend.
LLM_DAILY_TOKEN_CAP=0
# The same per UTC hour, so a few clients cannot spend the whole day's budget in one hour: past it the rules planner
# decides until the next hour. Counts every client together, so it holds whatever address a client shows.
LLM_HOURLY_TOKEN_CAP=0
# Longest a write, reset or agent run waits for its tenant's lock (an agent run holds it for its whole 60-150 s) before
# it is refused with 409 "retry shortly". Every waiter holds one of the server's worker threads; set 5 in public.
LOCK_WAIT_SECONDS=120
# Largest request body the app accepts on any path (the API, the UI's paths, /mcp); 413 before it is read.
MAX_BODY_BYTES=65536
# The throttles count the TCP peer's address. Behind a reverse proxy uvicorn takes the client from X-Forwarded-For only
# when the peer is in FORWARDED_ALLOW_IPS (default 127.0.0.1); otherwise every client shares the proxy's one bucket.
# Name the proxy's address or network, e.g. 172.16.0.0/12 for a proxy in another container on a Docker bridge, or the
# VPC range behind an AWS load balancer: uvicorn then takes the rightmost address the proxies did not add, which a
# client cannot forge. Avoid *: with it uvicorn takes the LEFTMOST entry, which the client wrote itself whenever a
# proxy appends to the header instead of replacing it (an AWS ALB, Cloudflare and Render append), so a client could
# pick a fresh bucket per request. * is safe only behind a single proxy that overwrites the header (Caddy alone does).
# uvicorn reads it from the real environment, not from this file.
# FORWARDED_ALLOW_IPS=

# --- Slack (optional) ---------------------------------------------------------
# An incoming-webhook URL (Slack app -> Incoming Webhooks -> Add New Webhook to Workspace). When set, every status
# update the comms agent writes, and the update after a human confirms the fix, is also posted to that channel.
SLACK_WEBHOOK_URL=
