# Template for /opt/oncall-brain/.env on the AWS box (docs/DEPLOY.md section D). user-data.sh copies it, fills in
# DOMAIN, MCP_TOKEN and FALKORDB_PASSWORD, and makes it readable by root only (chmod 600). To change a value later:
#   sudo nano /opt/oncall-brain/.env && cd /opt/oncall-brain && sudo docker compose up -d
# (`up -d` recreates the containers whose settings changed; `restart` would keep the old values.)
# docker compose reads this file to fill ${...} in the compose files; the app gets only the names those files list.

# Both compose files, so a plain `docker compose ...` in /opt/oncall-brain runs the AWS setup.
COMPOSE_FILE=docker-compose.yml:deploy/aws/docker-compose.aws.yml

# The public hostname: Caddy gets its HTTPS certificate and the app accepts it as Host. user-data.sh sets
# <public-ip-with-dashes>.sslip.io. A domain of your own works too: point its A record at the instance first.
DOMAIN=

# Bearer token for https://<DOMAIN>/mcp (the Claude Code plugin's ONCALL_BRAIN_TOKEN). user-data.sh generates it.
MCP_TOKEN=
# Password FalkorDB requires. Only the app can reach FalkorDB anyway; this is a second lock. Generated.
FALKORDB_PASSWORD=

# Planner. With LLM_API_KEY empty the deterministic planner runs and nothing is billed.
LLM_PROVIDER=anthropic
# Empty = the provider default (claude-sonnet-5-5). The recorded runs in docs/LLM_RUN.md used claude-opus-5-5.
LLM_MODEL=
LLM_API_KEY=

# Optional: post every status update to a Slack channel (incoming-webhook URL).
SLACK_WEBHOOK_URL=

# Public limits. Defaults live in deploy/aws/docker-compose.aws.yml (RATE_LIMIT_PER_MIN=120, WRITES_PER_MIN=20,
# RUNS_PER_HOUR=12, MAX_CONCURRENT_RUNS=2, LLM_DAILY_TOKEN_CAP=2000000, LLM_HOURLY_TOKEN_CAP=500000,
# LLM_RUN_TOKEN_CAP=150000, LOCK_WAIT_SECONDS=5, MAX_TENANTS=20, MAX_BODY_BYTES=65536).
# Set one here to change it, e.g. RUNS_PER_HOUR=20 while you record the demo video.
